@using StoryForge.Application.Projects.Operations
@using StoryForge.Core.Projects
@using StoryForge.Presentation.Home
@using System.IO
@inject NavigationManager navigationManager
@inject IFileDialogService fileDialog
@inject DialogService dialog
@inject ToastService toast
@inject ISender sender
@inject IProjectSessionHandler projectSession

<BbDropdownMenu>
    <BbDropdownMenuTrigger AsChild>
        <BbButton Variant="ButtonVariant.Ghost" Class="sf-project-trigger" AriaLabel="Project menu" title="@projectName">
            <LucideIcon Name="book-open-text" Size="19" Class="sf-project-icon" />
            <span class="sf-project-copy">
                <span class="sf-project-name">@projectName</span>
                <span class="sf-project-caption">@projectCaption</span>
            </span>
            <LucideIcon Name="chevrons-up-down" Size="14" Class="sf-project-chevron" />
        </BbButton>
    </BbDropdownMenuTrigger>
    <BbDropdownMenuContent Class="w-60">
        <BbDropdownMenuLabel>Project</BbDropdownMenuLabel>
        <BbDropdownMenuSeparator />
        <BbDropdownMenuItem OnClick="ShowNewProjectDialog">
            <LucideIcon Name="file-plus" Size="16" /> New project
        </BbDropdownMenuItem>
        <BbDropdownMenuItem OnClick="OpenProject">
            <LucideIcon Name="folder-open" Size="16" /> Open project
        </BbDropdownMenuItem>
        @if (projectSession.IsActive)
        {
            <BbDropdownMenuSeparator />
            <BbDropdownMenuItem OnClick="CloseProject">Close project</BbDropdownMenuItem>
        }
    </BbDropdownMenuContent>
</BbDropdownMenu>
@code {
    string projectName = "Your workspace";

    string projectCaption => projectSession.IsActive ? "Current project" : "Your stories, all together";

    protected override async Task OnInitializedAsync()
    {
        if (!projectSession.IsActive) return;
        var result = await sender.Send(new GetRecentProjectsOperation());
        projectName = result.Or([])
            .FirstOrDefault(project => string.Equals(project.FilePath, projectSession.CurrentProject, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Path.GetFileNameWithoutExtension(projectSession.CurrentProject)
            ?? "Current project";
    }

    async Task ShowNewProjectDialog()
    {
        var result = await dialog.OpenAsync<NewProjectDialog>(
            new DialogOpenOptions
            {
                Title = "New Project",
                Size = DialogSize.Small
            });

        if (result.Cancelled) return;

        var project = result.GetData<NewProjectDialog.ProjectDetails>();
        if (project is null || string.IsNullOrWhiteSpace(project.Name)) return;

        await OnCreateNewProject(project.Name.Trim(), project.Path);
    }

    async Task OnCreateNewProject(string name, string path)
    {
        var projectResult = await sender.Send(new CreateProjectOperation(name, path));
        projectResult
            .OnError(msg => toast.Error(msg))
            .Then(() => navigationManager.NavigateTo("/general", true));
    }

    async Task OpenProject()
    {
        var filePath = await fileDialog.ShowOpenFileAsync("Choose project file", ("Project database", "*.db"));
        if (filePath is null) return;

        var projectResult = await sender.Send(new OpenProjectPathOperation(filePath));
        projectResult
            .OnError(msg => toast.Error(msg))
            .Then(() => navigationManager.NavigateTo("/general", true));
    }

    async Task CloseProject()
    {
        var projectResult = await sender.Send(new CloseProjectOperation());
        projectResult
            .OnError(msg => toast.Error(msg))
            .Then(() => navigationManager.NavigateTo("/", true));
    }
}
