<div class="sf-dialog-fields">
    <div class="sf-dialog-field">
        <BbLabel For="name">@NameLabel</BbLabel>
        <BbInput Id="name" @bind-Value="name" />
    </div>
</div>
<BbDialogFooter>
    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">Cancel</BbButton>
    <BbButton OnClick="ConfirmAsync" Disabled="@string.IsNullOrWhiteSpace(name)">Create</BbButton>
</BbDialogFooter>

@code {
    [CascadingParameter]
    public IDialogReference Dialog { get; set; } = default!;

    [Parameter]
    public string NameLabel { get; set; } = "Name";

    string name { get; set; } = string.Empty;

    Task CancelAsync() => Dialog.CancelAsync();

    Task ConfirmAsync() => Dialog.CloseAsync(DialogResult.Ok(name));
}
