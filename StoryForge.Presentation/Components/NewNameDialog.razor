<div class="grid gap-4 py-4">
    <div class="grid grid-cols-4 items-center gap-4">
        <BbLabel For="name" Class="text-right">@NameLabel</BbLabel>
        <BbInput Id="name" @bind-Value="name" Class="col-span-3" />
    </div>
</div>
<BbDialogFooter>
    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">Cancel</BbButton>
    <BbButton OnClick="ConfirmAsync">Confirm</BbButton>
</BbDialogFooter>

@code {
    [CascadingParameter]
    public IDialogReference Dialog { get; set; } = default!;

    [Parameter]
    public string NameLabel { get; set; } = "Name";

    string name { get; set; } = string.Empty;

    Task CancelAsync() => Dialog.CancelAsync();

    Task ConfirmAsync() => Dialog.CloseAsync(DialogResult.Ok(name));
}
