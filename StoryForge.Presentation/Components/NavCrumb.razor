@inject BreadCrumbHandler handler
@implements IDisposable

<BbBreadcrumb>
    <BbBreadcrumbList>
        @for (int i = 0; i < items.Count; i++)
        {
            var item = items[i];
            <BbBreadcrumbItem>
                @if (item.Icon is not null)
                {
                    <LucideIcon Name="@item.Icon" class="h-3.5 w-3.5 mr-1" />
                }
                @if (item.Path is null || i == items.Count - 1)
                {
                    <BbBreadcrumbPage>@item.Label</BbBreadcrumbPage>
                }
                else
                {
                    <BbBreadcrumbLink Href="@item.Path">@item.Label</BbBreadcrumbLink>
                }
            </BbBreadcrumbItem>
            if (i < items.Count - 1)
            {
                <BbBreadcrumbSeparator />
            }
        }
    </BbBreadcrumbList>
</BbBreadcrumb>

@code {
    List<BreadCrumbHandler.Item> items = [];

    protected override void OnInitialized()
    {
        items = handler.Items;
        handler.NavigationChange += OnNavigationChanged;
    }

    public void Dispose() => handler.NavigationChange -= OnNavigationChanged;

    void OnNavigationChanged()
    {
        items = handler.Items;
        _ = InvokeAsync(StateHasChanged);
    }
}
