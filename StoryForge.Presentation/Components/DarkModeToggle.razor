@inject SceneLighting lighting

<BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="w-8 h-8" OnClick="ToggleDarkMode" AriaLabel="@label" title="@label">
    @if (isDarkMode)
    {
        <LucideIcon Name="sun" Size="20" />
    }
    else
    {
        <LucideIcon Name="moon" Size="20" />
    }
</BbButton>

@code {
    bool isDarkMode { get; set; }

    string label => isDarkMode ? "Switch to light theme" : "Switch to dark theme";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await lighting.IsDarkMode();
            StateHasChanged();
        }
    }

    async Task ToggleDarkMode()
    {
        await lighting.ToggleDarkMode();
        isDarkMode = !isDarkMode;
    }
}
