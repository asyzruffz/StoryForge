@page "/characters"
@using StoryForge.Application.Characters.Operations
@using StoryForge.Core.Data
@inject BreadCrumbHandler crumbHandler
@inject DialogService dialog
@inject ISender sender

<PageTitle>@Title</PageTitle>
<PageHeader Title="@Title" Eyebrow="Story development" Description="Meet the people who give your story its heart.">
    <BbButton OnClick="CreateCharacterAsync"><LucideIcon Name="plus" Class="mr-2 h-4 w-4" />New character</BbButton>
</PageHeader>

@if (!characters.Any())
{
    <BbEmpty Class="sf-empty" Title="Your cast starts here" Description="Give your first character a name, then discover what they want and what stands in their way.">
        <Icon><span class="sf-destination-icon"><LucideIcon Name="users" Size="24" /></span></Icon>
        <ChildContent><BbButton OnClick="CreateCharacterAsync">Create your first character</BbButton></ChildContent>
    </BbEmpty>
}
else
{
    <div class="sf-collection">
        @foreach (var group in characters.GroupBy(character => character.Importance))
        {
            <BbCard Class="sf-card">
                <BbCardHeader>
                    <BbCardTitle Class="sf-group-heading">@group.Key <span class="sf-count">@group.Count()</span></BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="sf-entity-grid">
                    @foreach (var character in group)
                    {
                        <BbItem AsChild="a" Href="@($"/characters/{character.IdString}")" Class="sf-entity" Variant="ItemVariant.Outline">
                            <BbItemMedia><span class="sf-entity-icon"><LucideIcon Name="users" Size="19" /></span></BbItemMedia>
                            <BbItemContent><BbItemTitle Class="sf-entity-title">@character.Name</BbItemTitle></BbItemContent>
                            <LucideIcon Name="arrow-up-right" Size="16" Class="sf-entity-arrow" />
                        </BbItem>
                    }
                </BbCardContent>
            </BbCard>
        }
    </div>
}
@code {
    const string Title = "Characters";
    IEnumerable<CharacterEntry> characters = [];

    protected override async Task OnInitializedAsync()
    {
        crumbHandler.Items.Clear();
        crumbHandler.Items.Add(new(Title, "/characters", "users"));
        crumbHandler.NavigationChange?.Invoke();
        await LoadCharactersAsync();
    }

    async Task LoadCharactersAsync() => characters = (await sender.Send(new GetCharacterEntriesOperation())).Or([]);

    async Task CreateCharacterAsync()
    {
        var result = await dialog.OpenAsync<NewNameDialog>(new Dictionary<string, object?> { [nameof(NewNameDialog.NameLabel)] = "Character name" }, new DialogOpenOptions { Title = "Create New Character", Size = DialogSize.Small });
        var name = result.Cancelled ? null : result.GetData<string>()?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        await sender.Send(new CreateCharacterOperation(name));
        await LoadCharactersAsync();
    }
}
