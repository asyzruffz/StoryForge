@page "/world"
@using StoryForge.Application.StorySettings.Operations
@using StoryForge.Core.Data
@inject BreadCrumbHandler crumbHandler
@inject DialogService dialog
@inject ISender sender

<PageTitle>@Title</PageTitle>
<PageHeader Title="@Title" Eyebrow="Story development" Description="Build a world your readers can get lost in.">
    <BbButton OnClick="CreateSettingAsync"><LucideIcon Name="plus" Class="mr-2 h-4 w-4" />New setting</BbButton>
</PageHeader>

@if (!settings.Any())
{
    <BbEmpty Class="sf-empty" Title="A world of possibilities" Description="Start with a place, a culture, or a detail that makes your story world feel alive.">
        <Icon><span class="sf-destination-icon"><LucideIcon Name="earth" Size="24" /></span></Icon>
        <ChildContent><BbButton OnClick="CreateSettingAsync">Create your first setting</BbButton></ChildContent>
    </BbEmpty>
}
else
{
    <div class="sf-collection">
        @foreach (var group in settings.GroupBy(setting => setting.Category))
        {
            <BbCard Class="sf-card">
                <BbCardHeader>
                    <BbCardTitle Class="sf-group-heading">@group.Key <span class="sf-count">@group.Count()</span></BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="sf-entity-grid">
                    @foreach (var setting in group)
                    {
                        <BbItem AsChild="a" Href="@($"/world/{setting.IdString}")" Class="sf-entity" Variant="ItemVariant.Outline">
                            <BbItemMedia><span class="sf-entity-icon"><LucideIcon Name="earth" Size="19" /></span></BbItemMedia>
                            <BbItemContent><BbItemTitle Class="sf-entity-title">@setting.Name</BbItemTitle></BbItemContent>
                            <LucideIcon Name="arrow-up-right" Size="16" Class="sf-entity-arrow" />
                        </BbItem>
                    }
                </BbCardContent>
            </BbCard>
        }
    </div>
}
@code {
    const string Title = "World";
    IEnumerable<StorySettingEntry> settings = [];

    protected override async Task OnInitializedAsync()
    {
        crumbHandler.Items.Clear();
        crumbHandler.Items.Add(new(Title, "/world", "earth"));
        crumbHandler.NavigationChange?.Invoke();
        await LoadSettingsAsync();
    }

    async Task LoadSettingsAsync() => settings = (await sender.Send(new GetStorySettingEntriesOperation())).Or([]);

    async Task CreateSettingAsync()
    {
        var result = await dialog.OpenAsync<NewNameDialog>(new Dictionary<string, object?> { [nameof(NewNameDialog.NameLabel)] = "Setting name" }, new DialogOpenOptions { Title = "Create New Setting", Size = DialogSize.Small });
        var name = result.Cancelled ? null : result.GetData<string>()?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        await sender.Send(new CreateStorySettingOperation(name));
        await LoadSettingsAsync();
    }
}
