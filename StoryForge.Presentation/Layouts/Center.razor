<Box Class="@GetClassNames()">
    @ChildContent
</Box>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    string GetClassNames()
    {
        return string.Join(" ", "flex justify-center items-center h-full", Class);
    }
}
