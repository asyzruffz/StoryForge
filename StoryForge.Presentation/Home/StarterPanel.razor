@using StoryForge.Application.Projects.Operations
@using StoryForge.Core.Projects
@inject NavigationManager navigationManager
@inject IFileDialogService fileDialog
@inject DialogService dialog
@inject ToastService toast
@inject ISender sender

<div class="sf-home-grid">
    <BbCard Class="sf-card">
        <BbCardHeader>
            <BbCardTitle>Pick up where you left off</BbCardTitle>
            <BbCardDescription>Your three most recently opened projects.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            @if (recentProjects.Any())
            {
                <div class="sf-project-list">
                    @foreach (var project in recentProjects)
                    {
                        <BbItem AsChild="button" @onclick="@(() => OpenProject(project.FilePath))"
                                Class="sf-project-row sf-entity" Variant="ItemVariant.Outline">
                            <BbItemMedia>
                                <span class="sf-entity-icon"><LucideIcon Name="book-open-text" Size="19" /></span>
                            </BbItemMedia>
                            <BbItemContent>
                                <BbItemTitle Class="sf-entity-title">@project.Name</BbItemTitle>
                                <span class="sf-project-path" title="@project.FilePath">@project.FilePath.EllipsisMiddle(65)</span>
                            </BbItemContent>
                            <LucideIcon Name="arrow-up-right" Size="16" Class="sf-entity-arrow" />
                        </BbItem>
                    }
                </div>
            }
            else
            {
                <BbEmpty Title="Your bookshelf awaits"
                         Description="Create a project or open an existing one. Your recent stories will appear here.">
                    <Icon><LucideIcon Name="book-open-text" Class="h-10 w-10" /></Icon>
                </BbEmpty>
            }
        </BbCardContent>
    </BbCard>
    <div class="sf-home-actions">
        <button type="button" class="sf-destination sf-home-action sf-home-action-primary" @onclick="ShowNewProjectDialog">
            <LucideIcon Name="file-plus" Size="24" />
            <div><h3>Begin a new story</h3><p>A fresh space for your characters, plots, and possibilities.</p></div>
            <span class="sf-destination-link">Create project <LucideIcon Name="arrow-right" Size="16" /></span>
        </button>
        <button type="button" class="sf-destination sf-home-action" @onclick="OpenFileBrowser">
            <LucideIcon Name="folder-open" Size="24" />
            <div><h3>Open a project</h3><p>Bring an existing StoryForge project into your workspace.</p></div>
            <span class="sf-destination-link">Browse files <LucideIcon Name="arrow-right" Size="16" /></span>
        </button>
    </div>
</div>
@code {
    IEnumerable<Project> recentProjects = [];

    protected override async Task OnInitializedAsync()
    {
        var projectsResult = await sender.Send(new GetRecentProjectsOperation());
        recentProjects = projectsResult.Or([])
            .OrderByDescending(p => p.LastActive)
            .Take(3)
            .ToList();
    }

    async Task ShowNewProjectDialog()
    {
        var result = await dialog.OpenAsync<NewProjectDialog>(
            new DialogOpenOptions
            {
                Title = "New Project",
                Size = DialogSize.Small
            });

        if (result.Cancelled) return;

        var project = result.GetData<NewProjectDialog.ProjectDetails>();
        if (project is null || string.IsNullOrWhiteSpace(project.Name)) return;

        await OnCreateNewProject(project.Name.Trim(), project.Path);
    }

    async Task OnCreateNewProject(string name, string path)
    {
        var projectResult = await sender.Send(new CreateProjectOperation(name, path));
        projectResult
            .OnError(msg => toast.Error(msg))
            .Then(() => navigationManager.NavigateTo("/general", true));
    }

    async Task OpenFileBrowser()
    {
        var filePath = await fileDialog.ShowOpenFileAsync("Choose project file", ("Project database", "*.db"));
        if (filePath is null) return;
        await OpenProject(filePath);
    }

    async Task OpenProject(string filePath)
    {
        var projectResult = await sender.Send(new OpenProjectPathOperation(filePath));
        projectResult
            .OnError(msg => toast.Error(msg))
            .Then(() => navigationManager.NavigateTo("/general", true));
    }
}
