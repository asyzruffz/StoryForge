<div class="sf-dialog-fields">
    <div class="sf-dialog-field">
        <BbLabel For="project-name">Project name</BbLabel>
        <BbInput Id="project-name" @bind-Value="projectName" />
    </div>
    <div class="sf-dialog-field">
        <BbLabel For="project-path">Project path</BbLabel>
        <BbInput Id="project-path" @bind-Value="projectPath" />
    </div>
</div>
<BbDialogFooter>
    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">Cancel</BbButton>
    <BbButton OnClick="ConfirmAsync" Disabled="@string.IsNullOrWhiteSpace(projectName)">Create project</BbButton>
</BbDialogFooter>

@code {
    [CascadingParameter]
    public IDialogReference Dialog { get; set; } = default!;

    string projectName { get; set; } = string.Empty;
    string projectPath { get; set; } = string.Empty;

    Task CancelAsync() => Dialog.CancelAsync();

    Task ConfirmAsync() => Dialog.CloseAsync(DialogResult.Ok(new ProjectDetails(projectName, projectPath)));

    public sealed record ProjectDetails(string Name, string Path);
}
