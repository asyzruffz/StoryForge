@page "/plots"
@using StoryForge.Application.Plots.Operations
@using StoryForge.Core.Data
@inject BreadCrumbHandler crumbHandler
@inject DialogService dialog
@inject ISender sender

<PageTitle>@Title</PageTitle>
<PageHeader Title="@Title" Eyebrow="Story development" Description="Follow the threads of conflict, consequence, and change.">
    <BbButton OnClick="CreatePlotAsync"><LucideIcon Name="plus" Class="mr-2 h-4 w-4" />New plot</BbButton>
</PageHeader>

@if (!plots.Any())
{
    <BbEmpty Class="sf-empty" Title="Every story needs a spark" Description="Create your first plot to explore a conflict and where it might lead.">
        <Icon><span class="sf-destination-icon"><LucideIcon Name="waypoints" Size="24" /></span></Icon>
        <ChildContent><BbButton OnClick="CreatePlotAsync">Create your first plot</BbButton></ChildContent>
    </BbEmpty>
}
else
{
    <div class="sf-collection">
        @foreach (var group in plots.GroupBy(plot => plot.Importance))
        {
            <BbCard Class="sf-card">
                <BbCardHeader>
                    <BbCardTitle Class="sf-group-heading">@group.Key <span class="sf-count">@group.Count()</span></BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="sf-entity-grid">
                    @foreach (var plot in group)
                    {
                        <BbItem AsChild="a" Href="@($"/plots/{plot.IdString}")" Class="sf-entity" Variant="ItemVariant.Outline">
                            <BbItemMedia><span class="sf-entity-icon"><LucideIcon Name="waypoints" Size="19" /></span></BbItemMedia>
                            <BbItemContent><BbItemTitle Class="sf-entity-title">@plot.Name</BbItemTitle></BbItemContent>
                            <LucideIcon Name="arrow-up-right" Size="16" Class="sf-entity-arrow" />
                        </BbItem>
                    }
                </BbCardContent>
            </BbCard>
        }
    </div>
}
@code {
    const string Title = "Plots";
    IEnumerable<PlotEntry> plots = [];

    protected override async Task OnInitializedAsync()
    {
        crumbHandler.Items.Clear();
        crumbHandler.Items.Add(new(Title, "/plots", "waypoints"));
        crumbHandler.NavigationChange?.Invoke();
        await LoadPlotsAsync();
    }

    async Task LoadPlotsAsync() => plots = (await sender.Send(new GetPlotEntriesOperation())).Or([]);

    async Task CreatePlotAsync()
    {
        var result = await dialog.OpenAsync<NewNameDialog>(new Dictionary<string, object?> { [nameof(NewNameDialog.NameLabel)] = "Plot name" }, new DialogOpenOptions { Title = "Create New Plot", Size = DialogSize.Small });
        var name = result.Cancelled ? null : result.GetData<string>()?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        await sender.Send(new CreatePlotOperation(name));
        await LoadPlotsAsync();
    }
}
