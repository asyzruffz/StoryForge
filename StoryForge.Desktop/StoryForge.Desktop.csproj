<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>wwwroot/favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Photino.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoryForge.Application\StoryForge.Application.csproj" />
    <ProjectReference Include="..\StoryForge.Core\StoryForge.Core.csproj" />
    <ProjectReference Include="..\StoryForge.Infrastructure\StoryForge.Infrastructure.csproj" />
    <ProjectReference Include="..\StoryForge.Presentation\StoryForge.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>